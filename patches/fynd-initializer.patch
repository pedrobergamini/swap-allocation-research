+//! A replaceable seed for Water-fill's 256-chunk passes.
+//!
+//! Water-fill runs a fine 256-chunk water-fill in two places: the refined disjoint split, which
+//! hands its result to exchange refinement, and fill-and-spill, whose result is a candidate as is.
+//! An initializer registered with
+//! [`WaterFillAlgorithm::with_fine_initializer`](super::WaterFillAlgorithm::with_fine_initializer)
+//! can propose that allocation instead in both. On the disjoint split it can also ask to skip
+//! exchange refinement and have its amounts taken as the split's result. Discovery, the coarse
+//! passes, the active sets, the other candidates and final selection are unchanged, and the best
+//! net candidate still wins, so a poor seed can only cost what the other candidates cannot
+//! recover; it never removes the 20-chunk floor or the single path.
+//!
+//! Fill-and-spill's active paths may share components. Probes price each path alone against
+//! untouched state, so an initializer that cannot account for shared components should decline
+//! when it sees them.
+
+use num_bigint::BigUint;
+use tycho_simulation::tycho_common::models::Address;
+
+use crate::types::ComponentId;
+
+/// One path of the active set, in the order the allocation must follow.
+#[derive(Debug, Clone)]
+pub struct ActivePath {
+    /// Components the path crosses, first hop first.
+    pub components: Vec<ComponentId>,
+    /// The order's input token, where the path starts.
+    pub token_in: Address,
+    /// The order's output token, where the path ends.
+    pub token_out: Address,
+}
+
+/// What a path pays for an amount swapped against untouched state.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct ProbeQuote {
+    /// Gross output in the output token's smallest unit.
+    pub amount_out: BigUint,
+    /// Gas units the path's swaps use.
+    pub gas: BigUint,
+}
+
+/// What each chunk of the 20-chunk pass added to one path's gross output.
+///
+/// The pass already priced these on the path's own drained state, so they cost an initializer
+/// nothing: they describe the path's output curve around its coarse amount.
+#[derive(Debug, Clone, Default, PartialEq, Eq)]
+pub struct ChunkGains {
+    /// Gross output each chunk the path won added, in the order it won them.
+    pub paid: Vec<BigUint>,
+    /// What the path's next chunk would have added when the pass ended. `None` for the path that
+    /// won the last chunk, a path whose price the pass had to forget, or a failed simulation.
+    pub next: Option<BigUint>,
+}
+
+/// The question put to an initializer: how to divide `amount_in` across `paths`.
+pub struct FineAllocationRequest<'r> {
+    /// The whole order, in the input token's smallest unit.
+    pub amount_in: &'r BigUint,
+    /// The active set, in allocation order.
+    pub paths: &'r [ActivePath],
+    /// The 20-chunk allocation that chose the active set, aligned with `paths`.
+    pub coarse: &'r [BigUint],
+    /// What each chunk of that pass added to each path, aligned with `paths`.
+    pub coarse_gains: &'r [ChunkGains],
+    probe: &'r mut dyn FnMut(usize, &BigUint) -> Option<ProbeQuote>,
+}
+
+impl<'r> FineAllocationRequest<'r> {
+    pub(super) fn new(
+        amount_in: &'r BigUint,
+        paths: &'r [ActivePath],
+        coarse: &'r [BigUint],
+        coarse_gains: &'r [ChunkGains],
+        probe: &'r mut dyn FnMut(usize, &BigUint) -> Option<ProbeQuote>,
+    ) -> Self {
+        Self { amount_in, paths, coarse, coarse_gains, probe }
+    }
+
+    /// Simulates `amount` through `paths[path_index]` inside the solve.
+    ///
+    /// Goes through the solve's swap cache, so an amount the solve already priced exactly costs
+    /// nothing, and every probe that does simulate is counted in the solve's own time.
+    pub fn probe(&mut self, path_index: usize, amount: &BigUint) -> Option<ProbeQuote> {
+        (self.probe)(path_index, amount)
+    }
+}
+
+/// What the disjoint split does with a proposed allocation.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum Refinement {
+    /// Run exchange refinement from the amounts, as it would from the fine water-fill.
+    Exchange,
+    /// Take the amounts as the disjoint split's result without exchange refinement.
+    ///
+    /// Fill-and-spill has no exchange refinement and ignores this. Every other candidate and the
+    /// best-net selection still run, so a skipped split still has to beat them to win.
+    Skip,
+}
+
+/// An initializer's proposal for the active set.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct FineAllocation {
+    /// One amount per active path, in allocation order, summing exactly to `amount_in`.
+    pub amounts: Vec<BigUint>,
+    /// Whether the disjoint split refines `amounts` or takes them as is.
+    pub refinement: Refinement,
+}
+
+/// Proposes the allocation exchange refinement starts from.
+pub trait FineAllocationInitializer: Send + Sync {
+    /// Returns an allocation for the active set, or `None` to keep Water-fill's own fine
+    /// allocation for this solve.
+    fn initial_allocation(&self, request: &mut FineAllocationRequest<'_>)
+        -> Option<FineAllocation>;
+}
