+    // ==================== Fine initializer ====================
+
+    /// Proposes a fixed percentage of the order for the first active path and the rest for the
+    /// second, with a fixed refinement choice.
+    struct FixedShareInitializer {
+        first_path_percent: u64,
+        refinement: Refinement,
+    }
+
+    impl FineAllocationInitializer for FixedShareInitializer {
+        fn initial_allocation(
+            &self,
+            request: &mut FineAllocationRequest<'_>,
+        ) -> Option<FineAllocation> {
+            let first = request.amount_in * self.first_path_percent / 100u64;
+            let second = request.amount_in - &first;
+            Some(FineAllocation { amounts: vec![first, second], refinement: self.refinement })
+        }
+    }
+
+    /// Runs the refined disjoint split alone, chained the way `find_best_route` chains it, so the
+    /// other candidates cannot hide what it returned. Returns the legs' input amounts, sorted, and
+    /// the split's gross output.
+    async fn refined_disjoint_split(initializer: FixedShareInitializer) -> (Vec<BigUint>, BigUint) {
+        let m = two_equal_weth_usdc(1);
+        let order = whole_weth_order(&m.weth, &m.usdc, 500);
+        let algorithm =
+            WaterFillAlgorithm::with_fine_initializer(config(), Arc::new(initializer)).unwrap();
+        let deadline = Deadline::new(Instant::now(), algorithm.timeout);
+        let SetupResult { input, mut cache, .. } = algorithm
+            .setup(
+                m.weighted.graph(),
+                m.market.clone(),
+                None,
+                Some(m.derived.clone()),
+                &order,
+                deadline,
+            )
+            .await
+            .expect("setup succeeds");
+        let disjoint = WaterFillAlgorithm::select_disjoint(&input.ordered, algorithm.max_paths);
+        let coarse = algorithm
+            .disjoint_waterfill(&input, &disjoint, COARSE_CHUNKS, true)
+            .expect("coarse pass succeeds");
+        let split = algorithm
+            .disjoint_refine(&input, &disjoint, &coarse, FINE_CHUNKS, &mut cache)
+            .expect("refined split succeeds");
+        let mut leg_amounts: Vec<BigUint> = split
+            .route
+            .swaps()
+            .iter()
+            .map(|swap| swap.amount_in().clone())
+            .collect();
+        leg_amounts.sort();
+        (leg_amounts, split.gross)
+    }
+
+    /// A 70/30 proposal on two equal components is far off the 50/50 optimum. Asked to skip, the
+    /// disjoint split returns it untouched; asked to exchange, refinement moves flow off it and
+    /// pays more.
