+    async fn test_skip_proposal_is_returned_without_exchange_refinement() {
+        let weth = BigUint::from(10u64).pow(18);
+        let proposed = vec![BigUint::from(150u64) * &weth, BigUint::from(350u64) * &weth];
+
+        let (skipped_legs, skipped_gross) = refined_disjoint_split(FixedShareInitializer {
+            first_path_percent: 70,
+            refinement: Refinement::Skip,
+        })
+        .await;
+        let (exchanged_legs, exchanged_gross) = refined_disjoint_split(FixedShareInitializer {
+            first_path_percent: 70,
+            refinement: Refinement::Exchange,
+        })
+        .await;
+
+        assert_eq!(skipped_legs, proposed, "a skipped proposal is the split as is");
+        assert_ne!(exchanged_legs, proposed, "an exchanged proposal is refined");
+        assert!(
+            exchanged_gross > skipped_gross,
+            "refinement should pay more: exchanged={exchanged_gross} skipped={skipped_gross}",
+        );
+    }
 }
